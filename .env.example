# CockroachDB Cloud connection string. Never commit the real value.
DATABASE_URL=postgresql://continuum_app:REPLACE_ME@cluster.cockroachlabs.cloud:26257/continuum?sslmode=verify-full
DATABASE_SECRET_ARN=arn:aws:secretsmanager:us-east-1:000000000000:secret:REPLACE_ME

# AWS Lambda / Bedrock
AWS_REGION=us-east-1
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_REASON_MODEL_ID=us.anthropic.claude-3-7-sonnet-20250219-v1:0
CONTINUUM_LAMBDA_NAME=continuum-memory-firewall
CONTINUUM_DEFAULT_ENFORCEMENT_MODE=shadow

# CockroachDB Cloud Managed MCP (configure auth in your MCP client)
COCKROACH_MCP_URL=https://cockroachlabs.cloud/mcp

# Explicit demo boundary. Production must set this to false.
CONTINUUM_DEMO_MODE=true
